# Copie este archivo como .env y cambie TODAS las claves antes de ejecutar:
#   cp .env.example .env
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.

# Superusuario de PostgreSQL (solo se usa para crear las bases de datos)
POSTGRES_PASSWORD=cambie-esta-clave-1

# Usuario propio de cada microservicio (base de datos por servicio)
MENU_DB_PASSWORD=cambie-esta-clave-2
PEDIDOS_DB_PASSWORD=cambie-esta-clave-3

# Credenciales del encargado de la cafetería (mínimo 8 caracteres)
ENCARGADO_USUARIO=encargado
ENCARGADO_PASSWORD=cambie-esta-clave-4
